# Copia este archivo a .env.development y .env.production y rellena
# con los valores de tu proyecto de Firebase (Configuración del proyecto
# > Tus apps > SDK de Firebase). Nunca subas .env.development ni
# .env.production al repositorio (ya están en .gitignore).

GATSBY_FIREBASE_API_KEY=
GATSBY_FIREBASE_AUTH_DOMAIN=
GATSBY_FIREBASE_PROJECT_ID=
GATSBY_FIREBASE_STORAGE_BUCKET=
GATSBY_FIREBASE_MESSAGING_SENDER_ID=
GATSBY_FIREBASE_APP_ID=
GATSBY_FIREBASE_MEASUREMENT_ID=
GATSBY_SITE_URL=https://tu-dominio
