rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }
    function underLimit() {
      return request.resource.size < 5 * 1024 * 1024; // 5 MB
    }
    function isAdmin() {
      return request.auth != null;
    }

    // Imágenes de contenido: lectura pública, escritura solo admin (imagen ≤ 5MB).
    match /events/{file=**} {
      allow read: if true;
      allow write: if isAdmin() && isImage() && underLimit();
    }
    match /gallery/{file=**} {
      allow read: if true;
      allow write: if isAdmin() && isImage() && underLimit();
    }
    match /siteConfig/{file=**} {
      allow read: if true;
      allow write: if isAdmin() && isImage() && underLimit();
    }
  }
}
